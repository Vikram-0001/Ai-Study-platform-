# FastAPI Server Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=super-secret-jwt-key-replace-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite by default, swap for PostgreSQL in production)
# For Supabase, use the Connection String: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./academic_assistant.db

# Supabase Auth Configuration (HS256 Secret from Project Settings -> API)
SUPABASE_JWT_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=study-files


# Vector Database (Qdrant)
# Use ":memory:" for zero-install local development or "http://localhost:6333" for Docker/Server
QDRANT_URL=:memory:
QDRANT_API_KEY=

# Cache Configuration
# Leave blank to fallback to in-memory caching
REDIS_URL=

# AI Provider Configurations
# If left blank, mock mode triggers for offline execution
GROQ_API_KEY=
TAVILY_API_KEY=

# Security configurations
ENABLE_SECURITY_GUARDRAILS=true
PII_REDACTION_LEVEL=HIGH
RATE_LIMIT_PER_MINUTE=60
